"используйте более простой блок значка."

#: pyblocks/snippets/pybricks/hub_display.py:33
msgid "Display a single character. Options: character."
msgstr "Показать один символ. Параметры: character."

#: pyblocks/snippets/python/basics.py:6
msgid ""
"Display a value in the console.\n"
"\n"
"The value can be quoted text, a number, or a variable name.\n"
"Use the console to see what happens in your program."
msgstr ""
"Показать значение в консоли.\n"

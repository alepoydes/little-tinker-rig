#: pyblocks/qt/firmware.py:166
msgid ""
"Bluetooth bootloader: turn the hub off. Hold its green button until the light flashes"
" purple, then release it. Keep the hub near the computer and close other Bluetooth "
"connections."
msgstr ""
"Загрузчик Bluetooth: выключите хаб. Удерживайте зелёную кнопку до мигания фиолетовым,"
" затем отпустите. Держите хаб рядом с компьютером и закройте другие подключения "
"Bluetooth."

#: pyblocks/qt/device.py:71
msgid "Bluetooth name"
msgstr "Имя Bluetooth"

#: pyblocks/qt/app.py:1093
msgid "Bluetooth, USB or virtual hub"
msgstr "Bluetooth, USB или виртуальный хаб"

#: pyblocks/qt/authoring.py:674
msgid "Body: an ordinary helper function with private local variables."
msgstr "Тело: обычная вспомогательная функция с собственными локальными переменными."

#: pyblocks/qt/authoring.py:671
msgid "Body: the Python inserted into the program."
msgstr "Тело: код Python, вставляемый в программу."

#: pyblocks/snippets/pybricks/drive.py:52
msgid "Brake both robot wheels."
msgstr "Затормозить оба колеса робота."

#: pyblocks/snippets/pybricks/drive_options.py:73
msgid "Build a drive base for a robot attribute or expression."
msgstr "Создать шасси для атрибута робота или выражения."

#: pyblocks/snippets/python/data.py:74
msgid ""
"Build a list by applying a function to every item.\n"
"\n"
"Choose a built-in or your own function. Edit the comprehension in Python\n"
"when you need filtering or a more complex expression."
msgstr ""
"Создать список, применив функцию к каждому элементу.\n"
"\n"
"Выберите встроенную или собственную функцию. Для фильтрации и более сложного\n"
"выражения отредактируйте списковое включение в Python."

#: pyblocks/qt/authoring.py:427
#, python-brace-format
msgid "Built-in · {name}"
msgstr "Встроенная · {name}"

#: pyblocks/snippets/python/basics.py:159
msgid ""
"Call a function or class and use its result.\n"
"\n"
"Choose the callable and edit its argument list. This also creates an instance\n"
"of a custom robot class or calls a method that returns a value."
msgstr ""
"Вызвать функцию или класс и использовать результат.\n"
"\n"
"Выберите вызываемый объект и измените список аргументов. Так можно создать\n"
"экземпляр собственного класса робота или вызвать метод с возвращаемым значением."

#: pyblocks/snippets/python/basics.py:121
msgid ""
"Call a function.\n"
"\n"
"Choose a function and add or remove its arguments."
msgstr ""
"Вызвать функцию.\n"
"\n"
"Выберите функцию, добавьте или удалите её аргументы."

#: pyblocks/qt/app.py:367
msgid "Cancel move"
msgstr "Отменить перенос"

#: pyblocks/qt/structure.py:280
msgid "Cannot change this expression"
msgstr "Не удалось изменить выражение"

#: pyblocks/qt/structure.py:171
msgid "Cannot change this list"
msgstr "Не удалось изменить список"

#: pyblocks/qt/controls.py:266
msgid "Center, °"
msgstr "Центр, °"

#: pyblocks/qt/annotations.py:24
msgid "Change a value"
msgstr "Изменить значение"

#: pyblocks/snippets/pybricks/hubs.py:30
msgid "Change the hub status light."
msgstr "Изменить цвет индикатора хаба."

#: pyblocks/snippets/pybricks/remote.py:50
msgid "Check a LEGO remote button in your own control loop."
msgstr "Проверить кнопку пульта LEGO в своём цикле управления."

#: pyblocks/qt/annotations.py:13
msgid "Check a condition"
msgstr "Проверить условие"

#: pyblocks/snippets/python/objects.py:92
msgid "Check an exception or class hierarchy."
msgstr "Проверить принадлежность к иерархии исключений или классов."

#: pyblocks/snippets/pybricks/keyboard.py:38
msgid "Check for input; zero milliseconds returns immediately."
msgstr "Проверить ввод; при нуле миллисекунд вернуться немедленно."

#: pyblocks/snippets/python/basics.py:90
msgid "Check that at least one condition is true."
msgstr "Проверить, что хотя бы одно условие истинно."

#: pyblocks/snippets/python/basics.py:84
msgid "Check that both conditions are true."
msgstr "Проверить, что оба условия истинны."

#: pyblocks/snippets/python/objects.py:44
msgid "Check that every value is true; stop at the first false value."
msgstr "Проверить истинность всех значений до первого ложного."

#: pyblocks/snippets/pybricks/hub_measurements.py:72
msgid "Check whether a USB charger is connected."
msgstr "Проверить подключение зарядного устройства USB."

#: pyblocks/snippets/python/data.py:66
msgid ""
"Check whether a collection contains a value.\n"
"\n"
"For dictionaries, this checks keys. For text, it checks substrings."
msgstr ""
"Проверить наличие значения в коллекции.\n"
"\n"
"В словаре проверяются ключи, в тексте — подстроки."

#: pyblocks/snippets/pybricks/hubs.py:74
msgid ""
"Check whether a hub button is pressed.\n"
"\n"
"Available buttons depend on the hub. The center button normally stops the\n"
"program; use left/right on Prime or Inventor without changing that behavior."
msgstr ""
"Проверить, нажата ли кнопка хаба.\n"
"\n"
"Доступные кнопки зависят от хаба. Центральная кнопка обычно останавливает\n"
"программу; на Prime и Inventor используйте левую или правую, сохраняя остановку."

#: pyblocks/snippets/pybricks/sensors.py:23
msgid "Check whether a surface is darker than a reflection threshold."
msgstr "Проверить, что поверхность темнее заданного порога отражения."

#: pyblocks/snippets/python/basics.py:50
msgid "Check whether a value is below a threshold."
msgstr "Проверить, что значение меньше порога."

#: pyblocks/snippets/python/objects.py:50
msgid "Check whether any value is true; stop at the first true value."
msgstr "Проверить наличие истинного значения до первого совпадения."

#: pyblocks/snippets/pybricks/sensors.py:102
msgid "Check whether the force sensor button is pressed."
msgstr "Проверить, нажата ли кнопка датчика силы."

#: pyblocks/snippets/pybricks/motor_motion.py:113
msgid "Check whether the motor cannot follow its commanded motion."
msgstr "Проверить, мешает ли нагрузка мотору выполнять движение."

#: pyblocks/snippets/pybricks/motor_motion.py:107
msgid "Check whether the motor has finished its movement."
msgstr "Проверить завершение движения."

#: pyblocks/snippets/python/basics.py:78
msgid "Check whether two values are equal."
msgstr "Проверить, равны ли два значения."

#: pyblocks/snippets/pybricks/hubs.py:88
msgid "Check which side of the hub faces upward."
msgstr "Проверить, какая сторона хаба направлена вверх."

#: pyblocks/qt/authoring.py:556
msgid "Checking… · showing the last valid preview"
msgstr "Проверка… · показан последний корректный предпросмотр"

#: pyblocks/qt/app.py:342
msgid "Child"
msgstr "Потомок"

#: pyblocks/qt/authoring.py:936
msgid "Choose a block to inspect its definition."
msgstr "Выберите блок, чтобы изучить его определение."

#: pyblocks/pybricks/firmware.py:176
msgid "Choose a firmware ZIP package for this hub"
msgstr "Выберите ZIP-пакет прошивки для этого хаба"

#: pyblocks/snippets/pybricks/randomness.py:6
msgid ""
"Choose a random integer, including both limits.\n"
"\n"
"Supported on Inventor, SPIKE Prime and Technic hubs.\n"
"BOOST Move Hub firmware does not include urandom."
msgstr ""
"Выбрать случайное целое число, включая обе границы.\n"
"\n"
"Работает на хабах Inventor, SPIKE Prime и Technic.\n"
"В прошивке BOOST Move Hub нет модуля urandom."

#: pyblocks/snippets/pybricks/randomness.py:17
msgid ""
"Choose a random item from a nonempty sequence.\n"
"\n"
"Available on Inventor, SPIKE Prime and Technic hubs; not on BOOST."
msgstr ""
"Выбрать случайный элемент непустой последовательности.\n"
"\n"
"Доступно на Inventor, SPIKE Prime и Technic; недоступно на BOOST."

#: pyblocks/snippets/python/flow.py:31
msgid ""
"Choose a value using a condition.\n"
"\n"
"Only the chosen expression is evaluated."
msgstr ""
"Выбрать значение по условию.\n"
"\n"
"Вычисляется только выбранное выражение."

#: pyblocks/snippets/python/basics.py:56
msgid "Choose between two actions using a condition."
msgstr "Выбрать одно из двух действий по условию."

#: pyblocks/snippets/pybricks/sensor_values.py:30
msgid "Choose the colors the sensor should recognize. Options: colors."
msgstr "Выбрать цвета для распознавания датчиком. Параметры: colors."

#: pyblocks/snippets/python/numbers.py:33
msgid "Choose the larger value."
msgstr "Выбрать большее значение."

#: pyblocks/snippets/python/numbers.py:27
msgid "Choose the smaller value."
msgstr "Выбрать меньшее значение."

#: pyblocks/snippets/python/objects.py:1
msgid ""
"Classes and generators\n"
"\n"
"Expert Python structure for reusable robot models and cooperative control."
msgstr ""
"Классы и генераторы\n"
"\n"
"Конструкции Python уровня «Эксперт» для моделей роботов и совместного управления."

#: pyblocks/qt/app.py:215
msgid "Clear"
msgstr "Очистить"

#: pyblocks/qt/structure.py:298
msgid "Clear expression"
msgstr "Очистить выражение"

#: pyblocks/qt/app.py:658
msgid "Clear recent files"
msgstr "Очистить список"

#: pyblocks/snippets/pybricks/hubs.py:133
msgid "Clear the hub display."
msgstr "Очистить экран хаба."

#: pyblocks/qt/firmware.py:102 pyblocks/qt/window.py:39
msgid "Close"
msgstr "Закрыть"

#: pyblocks/snippets/pybricks/lessons.py:124
msgid ""
"Close a gripper while pressed; open to its stop when released.\n"
"\n"
"Repeats until the program is stopped. Opening waits for a mechanical stall,\n"
"so a new press is handled after opening finishes. Requires physical stops."
msgstr ""
"Закрывать захват при нажатии, открывать до упора при отпускании.\n"
"\n"
"Повторяется до остановки программы. Открывание ждёт остановки об упор,\n"
"поэтому новое нажатие проверяется после его завершения. Нужны физические упоры."

#: pyblocks/qt/app.py:293
msgid "Close document"
msgstr "Закрыть документ"

#: pyblocks/qt/structure.py:211
msgid "Collapse block"
msgstr "Свернуть блок"

#: pyblocks/qt/authoring.py:266
msgid "Color"
msgstr "Цвет"

#: pyblocks/snippets/pybricks/sensor_values.py:1
msgid ""
"Color measurements\n"
"\n"
"Explicit device operations for studying complete robot programs."
msgstr ""
"Измерение цвета\n"
"\n"
"Отдельные операции с устройствами для изучения полных программ роботов."

#: pyblocks/qt/device.py:27

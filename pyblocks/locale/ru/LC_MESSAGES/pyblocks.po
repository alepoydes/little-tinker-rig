msgstr "Датчик цвета"

#: pyblocks/qt/device.py:77
msgid "Connect"
msgstr "Подключить"

#: pyblocks/snippets/pybricks/sensors.py:69
msgid "Connect a BOOST color and distance sensor."
msgstr "Подключить комбинированный датчик цвета и расстояния BOOST."

#: pyblocks/snippets/pybricks/xbox.py:6
msgid "Connect a Bluetooth Xbox controller (Pybricks 3.5 or later)."
msgstr "Подключить контроллер Xbox по Bluetooth (Pybricks 3.5 или новее)."

#: pyblocks/snippets/pybricks/remote.py:42
msgid "Connect a LEGO Powered Up remote for your own control loop."
msgstr "Подключить пульт LEGO Powered Up для своего цикла управления."

#: pyblocks/snippets/pybricks/sensors.py:14
msgid "Connect a color sensor to a hub port."
msgstr "Подключить датчик цвета к порту хаба."

#: pyblocks/snippets/pybricks/sensor_values.py:6
msgid "Connect a color sensor. Options: port."
msgstr "Подключить датчик цвета. Параметры: port."

#: pyblocks/snippets/pybricks/sensor_values.py:15
msgid "Connect a distance sensor. Options: port."
msgstr "Подключить датчик расстояния. Параметры: port."

#: pyblocks/snippets/pybricks/sensors.py:60
msgid "Connect a force sensor to measure presses."
msgstr "Подключить датчик силы для измерения нажатий."

#: pyblocks/qt/device.py:169
msgid "Connect a hub at the top right of the window."
msgstr "Подключение — в правом верхнем углу окна."

#: pyblocks/qt/robot.py:105 pyblocks/qt/robot.py:110 pyblocks/qt/robot.py:115
#: pyblocks/qt/robot.py:120
msgid "Connect a hub first"
msgstr "Сначала подключите хаб"

#: pyblocks/snippets/pybricks/motor_motion.py:210
msgid "Connect a motor and account for its gears in every movement."
msgstr "Подключить мотор с учётом передачи во всех движениях."

#: pyblocks/snippets/pybricks/motors.py:22
msgid "Connect a motor and choose its positive direction."
msgstr "Подключить мотор и выбрать положительное направление вращения."

#: pyblocks/snippets/pybricks/motors.py:10
msgid ""
"Connect a motor to a hub port.\n"
"\n"
"Choose a port and an unquoted motor name, such as left_motor.\n"
"Available ports depend on the hub model."
msgstr ""
"Подключить мотор к порту хаба.\n"
"\n"
"Выберите порт и задайте имя мотора без кавычек, например left_motor.\n"
"Доступные порты зависят от модели хаба."

#: pyblocks/snippets/pybricks/motors.py:100
msgid ""
"Connect a motor with a position tolerance profile.\n"
"\n"
"A larger tolerance trades precision for smoother motion. Virtual hubs do\n"
"not model this controller profile."
msgstr ""
"Подключить мотор с профилем допустимой погрешности положения.\n"
"\n"
"Больший допуск уменьшает точность, но делает движение плавнее.\n"
"Виртуальный хаб не моделирует этот профиль регулятора."

#: pyblocks/qt/controls.py:246 pyblocks/qt/controls.py:386
msgid "Connect a virtual or physical hub at the top right."
msgstr "Подключите виртуальный или настоящий хаб в правом верхнем углу."

#: pyblocks/snippets/pybricks/sensors.py:51
msgid "Connect an ultrasonic distance sensor."
msgstr "Подключить ультразвуковой датчик расстояния."

#: pyblocks/pybricks/firmware.py:222
msgid "Connect exactly one matching hub in USB DFU mode"
msgstr "Подключите ровно один хаб нужной модели в режиме USB DFU"

#: pyblocks/qt/device.py:38
msgid "Connect hub"
msgstr "Подключить хаб"

#: pyblocks/snippets/pybricks/hubs.py:14
msgid "Connect to the BOOST Move Hub."
msgstr "Подключиться к хабу BOOST Move Hub."

#: pyblocks/snippets/pybricks/hubs.py:6
msgid "Connect to the SPIKE Prime or Robot Inventor hub."
msgstr "Подключиться к хабу SPIKE Prime или Robot Inventor."

#: pyblocks/snippets/pybricks/hubs.py:22
msgid "Connect to the Technic Hub."
msgstr "Подключиться к хабу Technic."

#: pyblocks/qt/device.py:70
msgid "Connection"
msgstr "Подключение"

#: pyblocks/qt/app.py:457
msgid "Connect…"
msgstr "Подключить…"


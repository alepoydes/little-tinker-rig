msgstr "Посчитать элементы коллекции или символы текста."

#: pyblocks/snippets/pybricks/sensor_values.py:48
msgid "Create a color from hue, saturation and brightness. Options: h, s, v."
msgstr "Создать цвет по тону, насыщенности и яркости. Параметры: h, s, v."

#: pyblocks/snippets/python/data.py:50
msgid ""
"Create a dictionary with a key and value.\n"
"\n"
"Add entries with the item-assignment block, or edit the dictionary in Python."
msgstr ""

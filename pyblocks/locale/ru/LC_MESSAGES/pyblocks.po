msgstr "Консоль · {p0}"

#: pyblocks/snippets/pybricks/motor_motion.py:82
msgid "Continuously track a changing target angle. Options: target_angle."
msgstr "Непрерывно следовать за изменяющимся целевым углом. Параметры: target_angle."

#: pyblocks/qt/navigation.py:19
msgid "Control"
msgstr "Управление"

#: pyblocks/snippets/python/data.py:44
msgid "Convert a value to text."
msgstr "Преобразовать значение в текст."

#: pyblocks/qt/authoring.py:243
msgid "Copy to my collection"
msgstr "Копировать в мою коллекцию"

#: pyblocks/qt/authoring.py:995
msgid "Correct this module's draft or choose another group before adding a block."
msgstr "Исправьте черновик модуля или выберите другую группу перед добавлением блока."

#: pyblocks/snippets/python/data.py:38
